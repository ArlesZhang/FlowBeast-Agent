# FlowBeast — Environment Configuration
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ======================
# 🤖 LLM Model Configuration
# ======================

# Which vendor to use for LLM (script generation).
# Options: anthropic, qwen, openai, gemini, deepseek, ollama, glm, openrouter
ACTIVE_VENDOR=qwen

# Specific model to use. If set, overrides the vendor default.
ACTIVE_MODEL=qwen3.6-plus

# ======================
# 🔑 API Keys (fill in the one for your chosen vendor)
# ======================

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Qwen / DashScope (Aliyun)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google / Gemini
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Zhipu / GLM
GLM_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ======================
# 🧬 Embedding Model Configuration (separate from LLM)
# ======================

# Which vendor for embeddings. Options: ollama, gemini, openai, qwen
EMBED_VENDOR=ollama

# Specific embedding model. If set, overrides the vendor default.
# ollama: nomic-embed-text (768-d, local, no API key needed)
# gemini: models/embedding-001 (1536-d)
# openai: text-embedding-3-small (1536-d)
# qwen: text-embedding-v3 (1024-d)
EMBED_MODEL=

# ======================
# 🖥️ Local Models (optional, for offline use)
# ======================
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ======================
# 🌐 Proxy (optional)
# ======================
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
